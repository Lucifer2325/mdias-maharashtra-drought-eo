# Application
API_KEY=your-secret-api-key-here
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql://mdias_user:mdias_pass@localhost:5432/mdias_db

# Redis (for Celery task queue and caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://mdias.yourdomain.com

# Google Earth Engine
GEE_SERVICE_ACCOUNT=mdias-gee@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=/run/secrets/gee_key.json

# AWS S3 (for raster storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET=mdias-geospatial-data

# ML Model
MODEL_PATH=/app/models/drought_risk_v1.json
