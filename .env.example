# ==========================================
# MDIAS — Environment Variables Template
# Copy to .env.local and fill in values
# ==========================================

# Database (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://user:password@localhost:5432/mdias?schema=public"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Earth Engine
GEE_SERVICE_ACCOUNT_EMAIL=mdias@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./gee-key.json
GEE_PROJECT_ID=your-gee-project

# NASA Earthdata
EARTHDATA_USERNAME=your_username
EARTHDATA_PASSWORD=your_password

# Python API (FastAPI microservice)
PYTHON_API_URL=http://localhost:8000
PYTHON_API_SECRET=your_internal_api_secret

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# AWS S3 / Cloudflare R2 (raster tile storage)
S3_BUCKET_NAME=mdias-tiles
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_ENDPOINT_URL=https://...r2.cloudflarestorage.com   # R2 only

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=alerts@mdias.in

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
